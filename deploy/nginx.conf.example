# Sesuaikan path dan sertifikat TLS melalui Certbot.
server {
    listen 80;
    server_name sewa.floofashionn.com;
    root /var/www/floo-attire/frontend/dist;
    index index.html;
    client_max_body_size 45M;

    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location /uploads/ {
        proxy_pass http://127.0.0.1:4000;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
